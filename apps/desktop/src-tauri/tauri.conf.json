{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MergeIQ",
  "version": "0.2.0",
  "identifier": "dev.mergeiq.app",
  "mainBinaryName": "mergeiq",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "MergeIQ",
        "width": 1200,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "msi",
      "nsis",
      "appimage",
      "deb"
    ],
    "publisher": "MergeIQ contributors",
    "copyright": "Copyright © MergeIQ contributors",
    "license": "Apache-2.0",
    "category": "DeveloperTool",
    "shortDescription": "Three-way merge editor for git conflicts",
    "longDescription": "MergeIQ resolves git merge conflicts with a three-way merge editor, a repository browser and a git mergetool integration.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "section": "devel",
        "priority": "optional",
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  }
}
